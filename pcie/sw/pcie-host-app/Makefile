####### Compile

main.o: main.cpp main.h \
		mainwindow.h \
		videofrm.h \
		pcie_host.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

mainwindow.o: mainwindow.cpp mainwindow.h \
		videofrm.h \
		ui_mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o mainwindow.cpp

videofrm.o: videofrm.cpp videofrm.h \
		pcie_host.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o videofrm.o videofrm.cpp

pcie_host.o: pcie_host.cpp pcie_host.h \
		mainwindow.h \
		videofrm.h \
		dma_xfer_utils.c
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o pcie_host.o pcie_host.cpp

moc_mainwindow.o: moc_mainwindow.cpp
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_videofrm.o: moc_videofrm.cpp
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_videofrm.o moc_videofrm.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/app1/bin || mkdir -p $(INSTALL_ROOT)/opt/app1/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/app1/bin/$(QMAKE_TARGET)
	-$(STRIP) $(INSTALL_ROOT)/opt/app1/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/app1/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/app1/bin/


install: install_target  FORCE

uninstall: uninstall_target  FORCE

