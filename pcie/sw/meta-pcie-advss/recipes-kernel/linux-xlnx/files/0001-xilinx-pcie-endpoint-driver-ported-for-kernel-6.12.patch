+	.attach = pciep_dma_buf_attach,
+	.detach = pciep_dma_buf_detatch,
+	.map_dma_buf = pciep_map_dma_buf,
+	.unmap_dma_buf = pciep_unmap_dma_buf,
+	.mmap = pciep_mmap,
