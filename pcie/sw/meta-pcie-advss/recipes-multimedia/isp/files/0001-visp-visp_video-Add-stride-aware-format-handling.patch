+#ifndef __VISP_ALIGN_H__
+#define __VISP_ALIGN_H__
+
+/*
+ * Runtime-configurable stride alignment in bytes.
+ * Both visp and visp_video modules reference this shared variable.
+ * Default: 16 bytes
+ * Can be modified via: /proc/visp-isp0/align_bytes (or similar procfs entry)
+ */
+extern unsigned int visp_stride_align_bytes;
+
+/*
+ * Runtime-configurable vb2 queue minimum queued buffers.
+ * Used by visp_video queue initialization.
+ * Default: 5
+ * Can be modified via: /proc/visp-ispX/visp-isp-subdevY using min_queued_buffers
+ */
+extern unsigned int visp_video_min_queued_buffers;
+
+#ifndef ALIGN_BYTES
+#define ALIGN_BYTES (visp_stride_align_bytes)
+#endif
+
+#endif /* __VISP_ALIGN_H__ */
