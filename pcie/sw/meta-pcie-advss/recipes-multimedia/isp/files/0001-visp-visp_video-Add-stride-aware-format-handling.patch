 	case MEDIA_PIX_FMT_SRGGB16:
 		IspFmt->out_format = CAMDEV_PIX_FMT_RAW16;
 		IspFmt->data_bits = 16;
+		IspFmt->buf_stride.raw = ALIGN(IspFmt->out_width * 2, ALIGN_BYTES);
