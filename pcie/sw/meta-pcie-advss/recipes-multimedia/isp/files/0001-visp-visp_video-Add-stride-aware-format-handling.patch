 	case MEDIA_PIX_FMT_SBGGR24:
 	case MEDIA_PIX_FMT_SGBRG24:
@@ -1272,11 +1321,15 @@ static int media_fmt_to_isp_fmt(uint32_t *media_fmt,
 	case MEDIA_PIX_FMT_SRGGB24:
 		IspFmt->out_format = CAMDEV_PIX_FMT_RAW24;
