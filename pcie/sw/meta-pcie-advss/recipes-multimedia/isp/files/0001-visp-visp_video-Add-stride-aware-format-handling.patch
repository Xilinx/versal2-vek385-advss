diff --git a/visp/visp_procfs.c b/visp/visp_procfs.c
index 3f8ee0d..331845c 100644
--- a/visp/visp_procfs.c
+++ b/visp/visp_procfs.c
@@ -60,6 +60,7 @@
 #include <linux/version.h>
 #include "visp_driver.h"
 #include "visp_procfs.h"
+#include "visp_align.h"
 
 struct visp_procfs {
 	struct proc_dir_entry *pde;
@@ -105,6 +106,10 @@ static int visp_procfs_info_show(struct seq_file *sfile, void *offset)
 		if (pad && (port != (pad_idx / VISP_PORT_PAD_NR))) {
 			port = pad_idx / VISP_PORT_PAD_NR;
 			seq_printf(sfile, "isp%d port%d:\n", isp_dev->id, port);
+			seq_printf(sfile, "align_bytes : %u\n",
+				visp_stride_align_bytes);
+			seq_printf(sfile, "min_queued_buffers : %u\n",
+				visp_video_min_queued_buffers);
 			seq_printf(sfile, "output_type: %s %s %s %s\n",
 				   type2str(isp_dev->output_type[port][0]),
 				   type2str(isp_dev->output_type[port][1]),
@@ -261,8 +266,37 @@ static int32_t visp_proc_process(struct seq_file *sfile,
 						       .sensor_info.one_json));
 					strncpy(isp_dev->isp_ports[port]
 						    .sensor_info.one_json,
-						val, strlen(val));
+						val, strlen(val));			}
+		} else if (strcmp(val, "align_bytes") == 0) {
+			val = strsep(&kv_cur, kv_delim);
+			if (val && isdigit(*val)) {
+				unsigned int new_align =
+					(unsigned int)simple_strtoul(val, &end, 0);
+				if (new_align > 0 && new_align <= 256) {
+					visp_stride_align_bytes = new_align;
+					seq_printf(sfile, "align_bytes set to %u\n",
+						visp_stride_align_bytes);
+				} else {
+					seq_printf(sfile,
+						"Invalid align_bytes value (must be 1-256)\n");
+				}				}
+		} else if (strcmp(val, "min_queued_buffers") == 0) {
+			val = strsep(&kv_cur, kv_delim);
+			if (val && isdigit(*val)) {
+				unsigned int new_min_queued_buffers =
+					(unsigned int)simple_strtoul(val, &end, 0);
+				if (new_min_queued_buffers > 0 &&
+				    new_min_queued_buffers <= 32) {
+					visp_video_min_queued_buffers =
+						new_min_queued_buffers;
+					seq_printf(sfile,
+						"min_queued_buffers set to %u\n",
+						visp_video_min_queued_buffers);
+				} else {
+					seq_printf(sfile,
+						"Invalid min_queued_buffers value (must be 1-32)\n");
 				}
+			}
