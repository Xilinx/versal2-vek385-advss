 	case MEDIA_PIX_FMT_SRGGB14DWA:
 		IspFmt->out_format = CAMDEV_PIX_FMT_RAW14_ALIGNED_MODE0;
 		IspFmt->data_bits = 14;
+		IspFmt->buf_stride.raw = ALIGN(DIV_ROUND_UP(IspFmt->out_width, 9) * 16, ALIGN_BYTES);
